# Copy to .env and fill in. Never commit .env.

# Local development database (docker compose). Dev-only credentials.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
# Host port the compose database is published on (5432 is often taken locally).
DB_HOST_PORT=5433

# Worker
WORKER_HEARTBEAT_SECONDS=5

# Daraja sandbox (not used yet)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
